# Режим работы Storage Service
# local - JSON файлы + локальная файловая система
# cloud - Firestore + Google Cloud Storage
STORAGE_MODE=local

# Настройки для локального режима
LOCAL_DB_PATH=./data/articles.json
LOCAL_FILES_PATH=./data/days

# Настройки для облачного режима
GCLOUD_PROJECT_ID=your-project-id
GCLOUD_CREDENTIALS=./keys/gcloud-key.json
FIRESTORE_COLLECTION=articles
GCS_BUCKET_NAME=your-bucket-name

# Настройки портов (опционально)
FRONTEND_PORT=3000
API_PORT=3001
STORAGE_PORT=3002

# Настройки окружения
NODE_ENV=development

# JWT настройки
JWT_ACCESS_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES=24h

# Session настройки
SESSION_SECRET=your-super-secret-session-key-change-in-production

# URL настройки для cookie-based sessions
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
STORAGE_URL=http://localhost:3002
