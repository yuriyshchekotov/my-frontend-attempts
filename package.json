{
  "name": "frontend-learning",
  "version": "1.0.0",
  "description": "Учебный блог на TypeScript + Express",
  "scripts": {
    "dev:old": "tsx watch legacy/src/server/index.ts",
    "build": "yarn build:shared && yarn build:api && yarn build:frontend && yarn build:storage",
    "build:shared": "yarn workspace @frontend-learning/shared build",
    "build:api": "yarn workspace @frontend-learning/api build",
    "build:frontend": "yarn workspace @frontend-learning/frontend build",
    "build:storage": "yarn workspace @frontend-learning/storage build",
    "clean": "rimraf frontend/dist api/dist storage/dist shared/dist",
    "dev:frontend": "yarn workspace @frontend-learning/frontend dev",
    "dev:api": "yarn workspace @frontend-learning/api dev",
    "dev:storage": "yarn workspace @frontend-learning/storage dev",
    "dev:shared": "yarn workspace @frontend-learning/shared dev",
    "start": "node dist/server/index.js",
    "log": "ts-node scripts/log-session.ts"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "typescript": "^5.6.3",
    "tsx": "^4.7.0",
    "@types/node": "^20.11.30",
    "rimraf": "^6.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.2",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "he": "^1.2.0",
    "inquirer": "^12.9.6",
    "jsdom": "^27.0.0",
    "multer": "^2.0.2",
    "sanitize-filename": "^1.6.3",
    "swagger-ui-dist": "^5.10.5",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "yamljs": "^0.3.0"
  },
  "resolutions": {
    "@types/express": "4.17.21"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/he": "^1.2.3",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.30",
    "@types/sanitize-filename": "^1.6.3",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "@types/yamljs": "^0.2.34",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3"
  },
  "private": true,
  "workspaces": [
    "frontend",
    "api",
    "storage",
    "shared"
  ]
}
